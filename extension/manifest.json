{
  "manifest_version": 3,
  "name": "Working-Bolt",
  "version": "1.0.0",
  "description": "Opens Working-Bolt over Lightning Bolt once you're signed in — no bookmark needed. Read-only; your sign-in stays with Lightning Bolt.",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "Open Working-Bolt", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "host_permissions": ["https://lblite.lightning-bolt.com/*"],
  "content_scripts": [{ "matches": ["https://lblite.lightning-bolt.com/*"], "js": ["launcher.js"], "run_at": "document_idle" }]
}
