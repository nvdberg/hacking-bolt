<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the real theming (see ui/Theme.kt); this is just the launch window. The parent is an
      AppCompat theme because the fingerprint dialog androidx.biometric shows on Android 8–9 needs one.
    -->
    <style name="Theme.WorkingBolt" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:statusBarColor">@color/launch_bg</item>
        <item name="android:navigationBarColor">@color/launch_bg</item>
    </style>
</resources>
